{
  "name": "interlink-support-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "InterLink customer-support bot: router + decision gate + admin web",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev:bot": "tsx watch src/bot/main.ts",
    "dev:admin": "tsx watch src/admin/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/cli/seed.ts",
    "eval": "tsx src/cli/eval.ts",
    "parity": "tsx src/cli/parity.ts",
    "import:legacy": "tsx src/cli/import-legacy.ts",
    "start:bot": "node dist/bot.js",
    "start:admin": "node dist/admin.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "@scure/bip39": "^2.4.0",
    "fastify": "^5.12.5",
    "franc-min": "^6.2.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
