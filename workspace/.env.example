# ===== Bắt buộc =====
# Postgres có pgvector. Dùng docker-compose thì tự đặt. Để chạy thử một tiến trình: pglite:./data/pgdata
DATABASE_URL=postgres://support:support@localhost:5432/support
POSTGRES_PASSWORD=change-me

# Bot Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook            # webhook (production) | polling (dev)
TELEGRAM_WEBHOOK_SECRET=         # chuỗi ngẫu nhiên dài; bắt buộc khi TELEGRAM_MODE=webhook
PUBLIC_BOT_URL=https://bot.example.com

# Admin: danh sách Telegram ID được phép đăng nhập trang quản trị (seed lần đầu).
# Trước đây các ID này bị ghi cứng trong AGENTS.md và admin-console/SKILL.md; nay chỉ nằm ở đây và trong DB (bảng admins).
ADMIN_TELEGRAM_IDS=
# Owner (Anh Phi): nhận cảnh báo FP-0, cảnh báo escalate > 100/ngày, đồng bộ whitepaper lỗi...
OWNER_TELEGRAM_ID=
PUBLIC_ADMIN_URL=https://admin.example.com
COOKIE_SECURE=true               # true khi sau HTTPS
TRUST_PROXY=true                 # true khi Admin API nằm sau reverse proxy (để giới hạn đăng nhập theo IP đúng)

# ===== LLM — qua 9router (gateway tương thích OpenAI) =====
# Không cấu hình thì bot chạy bằng template thuần, câu lạ được chuyển cho người thật.
# Toàn bộ 4 giá trị dưới đây chỉ là MẶC ĐỊNH: trong Admin Web (Cấu hình → Mô hình LLM) đổi model/URL/khoá được ngay, không cần deploy lại.
# Bot chạy trong Docker gọi 9router trên máy chủ qua host.docker.internal (chạy bot ngoài Docker thì dùng http://localhost:20128/v1).
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_API_KEY=              # API key tạo trong dashboard 9router
LLM_MODEL_FAST=cx/gpt-5.6-sol      # phân loại tầng 2, đọc ảnh, tóm tắt (model nhanh, rẻ)
LLM_MODEL_STRONG=cx/gpt-5.5     # dịch template, trả lời từ tri thức tầng 3 (model mạnh)
# Khoá mã hoá bí mật lưu trong DB (API key nhập từ Admin Web). Chuỗi ngẫu nhiên >= 32 ký tự; ĐỔI khoá này thì khoá đã lưu từ web mất hiệu lực.
SECRETS_KEY=

# Dự phòng tuỳ chọn: gọi thẳng API Anthropic khi 9router lỗi (bỏ trống nếu không dùng)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_MODEL_STRONG=claude-opus-5

# ===== Embedding đa ngôn ngữ — BAAI/bge-m3 chạy trong service `embedding` của docker-compose (TEI, CPU) =====
# Chọn bge-m3: 100+ ngôn ngữ (khách nhắn vi/en/zh/ko/ja/ru/ar...), 1024 chiều, không cần tiền tố query/passage nên
# cùng một cách gọi cho câu hỏi khách, câu hỏi mẫu của template và đoạn tri thức. Chi tiết chọn: docs/de_xuat_kien_truc_moi.md mục 12.
# Chạy bot/bench ngoài Docker: dùng EMBEDDING_URL=http://localhost:8081/v1 (service embedding mở cổng 8081 trên 127.0.0.1).
EMBEDDING_URL=http://embedding:80/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_HF_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ===== Tuỳ chọn =====
BOT_PORT=3000
ADMIN_PORT=3001
MEDIA_DIR=./data/media
CONTENT_DIR=content
LOG_LEVEL=info
