# ===== Bắt buộc =====
# Postgres có pgvector. Dùng docker-compose thì tự đặt. Để chạy thử một tiến trình: pglite:./data/pgdata
DATABASE_URL=postgres://support:support@localhost:5432/support
POSTGRES_PASSWORD=change-me

# Bot Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook            # webhook (production) | polling (dev)
TELEGRAM_WEBHOOK_SECRET=         # chuỗi ngẫu nhiên dài; bắt buộc khi TELEGRAM_MODE=webhook
PUBLIC_BOT_URL=https://bot.example.com

# Admin: danh sách Telegram ID được phép đăng nhập trang quản trị (seed lần đầu).
# Trước đây các ID này bị ghi cứng trong AGENTS.md và admin-console/SKILL.md; nay chỉ nằm ở đây và trong DB (bảng admins).
ADMIN_TELEGRAM_IDS=
# Owner (Anh Phi): nhận cảnh báo FP-0, cảnh báo escalate > 100/ngày, đồng bộ whitepaper lỗi...
OWNER_TELEGRAM_ID=
PUBLIC_ADMIN_URL=https://admin.example.com
COOKIE_SECURE=true               # true khi sau HTTPS
TRUST_PROXY=true                 # true khi Admin API nằm sau reverse proxy (để giới hạn đăng nhập theo IP đúng)

# ===== LLM (không bắt buộc: không có thì bot chạy bằng template thuần, câu lạ được chuyển cho người thật) =====
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5  # phân loại tầng 2, vision, tóm tắt
LLM_MODEL_STRONG=claude-opus-5   # dịch template, tri thức tầng 3

# Provider dự phòng, endpoint tương thích OpenAI (vd gateway hiện có). Được dùng khi provider chính lỗi/quá hạn mức.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_FAST=
OPENAI_COMPAT_MODEL_STRONG=

# Embedding đa ngôn ngữ (khuyến nghị cho production: bge-m3, voyage-multilingual, text-embedding-3-large...).
# Không cấu hình thì dùng embedding cục bộ đơn giản (đủ chạy, kém chính xác hơn với câu diễn đạt tự nhiên).
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ===== Tuỳ chọn =====
BOT_PORT=3000
ADMIN_PORT=3001
MEDIA_DIR=./data/media
CONTENT_DIR=content
LOG_LEVEL=info
